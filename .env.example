# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: 관리자 패널(Ctrl+Shift+A) 로그인 비밀번호. 서버에만 두고 화면 코드에는 넣지 않습니다.
# 비워 두면 관리자 로그인이 꺼집니다. 바꾸면 이미 로그인한 관리자는 모두 로그아웃됩니다.
ADMIN_PASSWORD=""

# CORS_ORIGINS: 이 서버의 /api 를 부를 수 있는 다른 화면 주소 (쉼표로 여러 개). 기본값: https://yourrhdiddl.github.io
CORS_ORIGINS="https://yourrhdiddl.github.io"

# CHAT_RATE_LIMIT_PER_MIN: 같은 IP에서 1분에 보낼 수 있는 채팅 수 (기본 10)
CHAT_RATE_LIMIT_PER_MIN="10"

# GEMINI_TIMEOUT_MS: Gemini 1번째 시도 대기 시간(ms, 기본 9000)
# GEMINI_TOTAL_BUDGET_MS: 혼잡·지연 시 한 번 더 시도할 때까지 합친 최대 대기 시간(ms, 기본 18000)
GEMINI_TIMEOUT_MS="9000"
GEMINI_TOTAL_BUDGET_MS="18000"

# GEMINI_MODEL: 처음 부를 모델 (기본 gemini-3.8-flash)
# GEMINI_FALLBACK_MODELS: 처음 모델이 혼잡하거나 느릴 때 순서대로 부를 대체 모델 (쉼표로 구분)
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite"
